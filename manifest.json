{
  "manifest_version": 3,
  "name": "Persistent Tab Renamer",
  "version": "1.0",
  "description": "Rename tabs and keep the name across refreshes.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "Rename tab" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" } }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
